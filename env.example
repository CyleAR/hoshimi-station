# Copy to .env (git-ignored) and fill in. Never commit real values.
HOSHIMI_SITE_URL=https://translate.example.com
ADMIN_NICKNAMES=
CODEX_API_TOKEN=
RECENT_WORK_API_TOKEN=
HYPER_API_KEY=
HYPER_BASE_URL=https://hyper.charm.land/v1
HYPER_MODEL=deepseek-v4-flash-0731
HYPER_REASONING_EFFORT=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
# Owner of ./data on the host (run `id -u`, `id -g`); the container runs as this user.
HOSHIMI_UID=1000
HOSHIMI_GID=1000
