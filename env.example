# Copy to .env (git-ignored) and fill in. Never commit real values.
HOSHIMI_SITE_URL=https://translate.example.com
ADMIN_NICKNAMES=
CODEX_API_TOKEN=
RECENT_WORK_API_TOKEN=
# Gemini free tier: set only GEMINI_API_KEY (model gemini-2.5-flash, 10 requests/min limiter).
# LiteLLM or any OpenAI-compatible proxy: set OPENAI_BASE_URL/KEY/MODEL and AI_RPM=0 (proxy rate-limits).
GEMINI_API_KEY=
AI_RPM=
HYPER_API_KEY=
HYPER_BASE_URL=
HYPER_MODEL=
HYPER_REASONING_EFFORT=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
# Optional JSON of extra headers for the AI provider, e.g. {"x-foo":"bar"} (opencode.ai's session header is added automatically).
AI_EXTRA_HEADERS=
# Owner of ./data on the host (run `id -u`, `id -g`); the container runs as this user.
HOSHIMI_UID=1000
HOSHIMI_GID=1000

# Line-break count gate (blocking on JP-EN \n counts + warning). Off when empty; set to 1 to re-enable.
GATE_LINE_BREAKS=
